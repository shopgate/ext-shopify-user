{
  "version": "4.0.0-beta.2",
  "id": "@shopgate/shopify-user",
  "trusted": true,
  "configuration": {
    "shopifyShopAlias": {
      "type": "admin",
      "destination" : "backend",
      "default": null,
      "params": {
        "type":  "text",
        "label": "Shopify Shop Alias",
        "description": "The part of your Shopify domain that comes before .myshopify.com; e.g. if your Shopify domain is https://myshop.myshopify.com, your alias is myshop.",
        "required": true
      }
    },
    "shopifyShopDomain": {
      "type": "admin",
      "destination" : "backend",
      "default": null,
      "params": {
        "type":  "text",
        "label": "Shopify Shop Domain",
        "description": "The full domain of your Shopify shop; e.g. myshop.com. This is optional and only needed if you have a custom domain for your Shopify shop.",
        "required": false
      }
    },
    "shopifyHeadlessStorefrontAccessToken": {
      "type": "admin",
      "destination" : "backend",
      "default": null,
      "params": {
        "type":  "text",
        "label": "Shopify Headless Storefront Access Token",
        "description": "The access token for your Shopify headless storefront.",
        "required": true
      }
    },
    "shopifyShopId": {
        "type": "admin",
        "destination": "backend",
        "default": null,
        "params": {
          "type":  "text",
          "label": "Shopify Shop ID",
          "description": "The ID of your Shopify shop when using password-less logins ('new' customer accounts).",
          "required": false
        }
    },
    "shopifyHeadlessApiClientId": {
        "type": "admin",
        "destination": "backend",
        "default": null,
        "params": {
          "type":  "text",
          "label": "Shopify Headless API Client ID",
          "description": "The client ID for your Shopify headless API when using password-less logins ('new' customer accounts).",
          "required": false
        }
    },
    "shopifyHeadlessApiClientSecret": {
        "type": "admin",
        "destination": "backend",
        "default": null,
        "params": {
          "type":  "text",
          "label": "Shopify Headless API Client Secret",
          "description": "The client secret for your Shopify headless API when using password-less logins ('new' customer accounts).",
          "required": false
        }
    },
    "shopifyHeadlessApiLoginRedirectUrl": {
        "type": "admin",
        "destination": "backend",
        "default": "https://connect.shopgate.com/trampoline/shopify_v1.html",
        "params": {
          "type":  "text",
          "label": "Shopify Headless API Login Redirect URL",
          "description": "The URL to redirect to after a successful login using the Shopify headless API (password-less / 'new' customer accounts).",
          "required": false
        }
    },
    "shopifyMultipassToken": {
      "type": "admin",
      "destination": "backend",
      "default": "",
      "params": {
        "type":  "text",
        "label": "Shopify Multipass Token",
        "description": "The multipass token for your Shopify store when using Multipass logins for SSO (only in combination with legacy customer accounts and Shopify Plus).",
        "required": false
      }
    },
    "shopifyLoginStrategy": {
      "type": "admin",
      "destination": "frontend",
      "default": "basic",
      "params": {
        "type": "string",
        "label": "Shopify Login Strategy",
        "description": "The login strategy. Use 'basic' for username & password logins (like 'legacy' customer accounts). Use 'shopifyHeadlessLogin' for password-less or some 3rd party logins (like 'new' customer accounts or any service connected via Shopify Plus SSO).",
        "required": false
      }
    },
    "showGuestCheckout": {
      "type": "admin",
      "destination": "frontend",
      "default": true,
      "params": {
        "type": "boolean",
        "label": "Show Guest Checkout Link",
        "description": "Allow customers to check out as guests.",
        "required": false
      }
    },
    "userDataCacheTtl": {
      "type": "static",
      "destination": "backend",
      "params": {
        "value": 600000
      }
    },
    "customerLinks": {
      "type": "admin",
      "destination": "frontend",
      "default": [
        {
          "key": "account",
          "show": false,
          "label": "Account",
          "target": "/account/profile",
          "icon": "AccountBoxIcon"
        },
        {
          "key": "orders",
          "show": false,
          "label": "Orders",
          "target": "/account/orders",
          "icon": "ChartIcon"
        }
      ],
      "params": {
        "type": "json",
        "label": "Custom user account links",
        "description": "Links/menu options to customer related pages that are displayed once a user is logged in. Each link should have a key, show, label, target and icon property."
      }
    }
  },
  "components": [
    {
      "id": "ShopifyHeadlessLogin",
      "target": "app.routes",
      "type": "portals",
      "path": "frontend/headlessLogin/routes/LoginScreen/index.jsx"
    },
    {
      "id": "HeadlessLoginSubscriptions",
      "path": "frontend/headlessLogin/subscribers.js",
      "type": "subscribers"
    },
    {
      "id": "LegacyLoginSubscriptions",
      "path": "frontend/legacyLogin/subscribers.js",
      "type": "subscribers"
    },
    {
      "id": "RegisterSubscription",
      "path": "frontend/Register/subscribers.js",
      "type": "subscribers"
    },
    {
      "id": "CheckoutSubscription",
      "path": "frontend/Checkout/subscribers.js",
      "type": "subscribers"
    },
    {
      "id": "GuestCheckoutLink",
      "path": "frontend/portals/GuestCheckoutLink/index.jsx",
      "target": "page.login.register-link.after",
      "type": "portals"
    },
    {
      "id": "GuestCheckoutSubscription",
      "path": "frontend/portals/GuestCheckoutLink/subscribers.js",
      "type": "subscribers"
    },
    {
      "id": "AccountSectionAndroid",
      "path": "frontend/portals/AccountSection",
      "target": "nav-menu.scanner.after",
      "type": "portals"
    },
    {
      "id": "AccountSectionIOS",
      "path": "frontend/portals/AccountSection",
      "target": "nav-menu.logout.before",
      "type": "portals"
    },
    {
      "id": "locale/en-US",
      "type": "translations",
      "path": "frontend/locale/en-US.json"
    },
    {
      "id": "locale/de-DE",
      "type": "translations",
      "path": "frontend/locale/de-DE.json"
    },
    {
      "id": "locale/fr-FR",
      "type": "translations",
      "path": "frontend/locale/fr-FR.json"
    },
    {
      "id": "locale/nl-NL",
      "type": "translations",
      "path": "frontend/locale/nl-NL.json"
    }
  ]
}
